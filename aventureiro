#include <stdio.h>

int main() {
    // ============================================
    // Simulação dos movimentos das peças de xadrez
    // Torre (for), Bispo (while), Rainha (do-while) e Cavalo (interativo)
    // ============================================

    // --------------------------------------------
    // TORRE - move-se 5 casas para a direita
    // --------------------------------------------
    int movimentoTorre = 5;
    printf("Movimento da Torre:\n");
    for (int i = 1; i <= movimentoTorre; i++) {
        printf("Direita %d\n", i);
    }

    // --------------------------------------------
    // BISPO - move-se 5 casas na diagonal
    // --------------------------------------------
    int movimentoBispo = 5;
    int contadorBispo = 1;

    printf("\nMovimento do Bispo:\n");
    while (contadorBispo <= movimentoBispo) {
        printf("Cima Direita %d\n", contadorBispo);
        contadorBispo++;
    }

    // --------------------------------------------
    // RAINHA - move-se 8 casas para a esquerda
    // --------------------------------------------
    int movimentoRainha = 8;
    int contadorRainha = 1;

    printf("\nMovimento da Rainha:\n");
    do {
        printf("Esquerda %d\n", contadorRainha);
        contadorRainha++;
    } while (contadorRainha <= movimentoRainha);

    // --------------------------------------------
    // CAVALO - movimento em "L" com interação do usuário
    // (dois movimentos verticais + um movimento horizontal)
    // --------------------------------------------
    int direcao;
    int casasVerticais = 2;
    int casasHorizontais = 1;
    int contador = 1;

    printf("\nEscolha a direção do movimento do Cavalo:\n");
    printf("1 - Baixo e Esquerda\n");
    printf("2 - Baixo e Direita\n");
    printf("3 - Cima e Esquerda\n");
    printf("4 - Cima e Direita\n");
    printf("Digite o número correspondente à direção (1, 2, 3 ou 4): ");
    scanf("%d", &direcao);

    printf("\nMovimento do Cavalo:\n");

    // Loop externo: movimento vertical (duas casas)
    for (int i = 1; i <= casasVerticais; i++) {
        if (direcao == 1 || direcao == 2)
          printf("Baixo %d\n", i);
        else
          printf("Cima %d\n", i);
        contador++;

}

// Loop interno: movimento horizontal (uma casa)
while (contador <= casasHorizontais) {
    if (direcao == 1 || direcao == 3)
        printf("Esquerda %d\n", contador);
    else
        printf("Direita %d\n", contador);
    contador++;
}

    // --------------------------------------------
    // Fim da simulação
    // --------------------------------------------
    printf("\nFim da simulação dos movimentos.\n");

    return 0;
}
    return 0;
}
